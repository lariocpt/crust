#!/usr/bin/env bash
# G35: resolve THIS script's real location before taking its directory.
#
# ${BASH_SOURCE[0]} is the path as INVOKED, not the file's own — and package
# managers install bins as symlinks into node_modules/.bin. Run from there, the old
# launcher looked for crust-bin (and ../src/index.ts) beside the .bin directory and
# found neither: `error: Module not found "…/node_modules/.bin/../src/index.ts"`.
#
# The loop uses plain `readlink`, not `readlink -f`, because BSD readlink — the
# darwin builds in the release matrix — has no -f. Following the chain hop by hop
# also covers a bin that symlinks to another symlink.

resolve_self() {
  local target="$1" link dir
  while [[ -L "$target" ]]; do
    if ! link="$(readlink "$target" 2>/dev/null)" || [[ -z "$link" ]]; then
      break # no usable readlink: best effort with the path we were given
    fi
    if [[ "$link" == /* ]]; then
      target="$link"
    else
      dir="$(cd "$(dirname "$target")" && pwd -P)" || break
      target="$dir/$link"
    fi
  done
  printf '%s' "$target"
}

SELF="$(resolve_self "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd -P)"

if [[ -x "$SCRIPT_DIR/crust-bin" ]]; then
  exec "$SCRIPT_DIR/crust-bin" "$@"
else
  exec bun "$SCRIPT_DIR/../src/index.ts" "$@"
fi
