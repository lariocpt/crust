{
  "name": "crust",
  "version": "0.1.0-dev",
  "description": "A Bun-powered shell with first-class pipelines and devops primitives",
  "type": "module",
  "bin": {
    "crust": "./bin/crust"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun src/index.ts",
    "build:shell": "bun build --compile --minify --bytecode --outfile bin/crust-bin src/index.ts",
    "build:fixture": "bun build --compile --minify --bytecode --outfile bin/crust-test-fixture src/testFixture/cli.ts",
    "build": "bun run build:shell && bun run build:fixture",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
