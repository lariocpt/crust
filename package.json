{
  "name": "crust",
  "version": "0.2.0-dev",
  "description": "Mock it, test it, load it, tail it: the whole test stack baked into one binary. Spec-driven, generated, zero dependencies.",
  "license": "MIT",
  "author": "Lario Borges",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lariocpt/crust.git"
  },
  "homepage": "https://lariocpt.github.io/crust-website/",
  "bugs": "https://github.com/lariocpt/crust/issues",
  "keywords": [
    "bun",
    "devops",
    "pipeline",
    "load-testing",
    "mock-server",
    "openapi",
    "testing",
    "fixtures",
    "test-generation",
    "cli"
  ],
  "type": "module",
  "bin": {
    "crust": "./bin/crust"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "dev": "bun src/index.ts",
    "build": "bun build --compile --minify --bytecode --outfile bin/crust-bin src/index.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
