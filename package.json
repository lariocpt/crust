{
  "name": "crust",
  "version": "0.1.0-dev",
  "description": "A Bun-powered shell with first-class pipelines and devops primitives",
  "type": "module",
  "bin": {
    "crust": "./bin/crust"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun src/index.ts",
    "build:shell": "bun build --compile --minify --bytecode --outfile bin/crust-bin src/index.ts",
    "build:fixture": "bun build --compile --minify --bytecode --outfile bin/crust-test-fixture src/testFixture/cli.ts",
    "build": "bun run build:shell && bun run build:fixture"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
