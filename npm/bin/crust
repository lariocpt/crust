#!/usr/bin/env node
// crust — launcher shim.
//
// The real binary is a ~91 MB Bun-compiled ELF living in the user's cache. This shim finds
// it, downloading it on first use if the postinstall never ran, and hands over the process.
//
// The lazy download is the load-bearing part: npm 12 blocks install scripts by DEFAULT, so
// a package that only fetches in postinstall installs "successfully" and then cannot run.
// Fetching here means `npm i -g crust` works under any script policy — the cost is that the
// very first invocation pays the download.
import { spawn } from "node:child_process";
import { ensureBinary, readManifest, installHint, resolveSource } from "../lib/install.mjs";

const say = (m) => console.error(`[crust] ${m}`);

function bail(lines, code = 127) {
  for (const l of lines) console.error(`[crust] ${l}`);
  process.exit(code);
}

// Pass the plane: readManifest's whole job is to reject a cached binary that
// belongs to a DIFFERENT artifact plane, and with no argument that guard is
// skipped — so CRUST_SOURCE was silently ignored on every run after the first.
let manifest = readManifest(resolveSource());

if (!manifest) {
  try {
    // Progress goes to stderr, never stdout: crust is a shell and gets piped, so anything on
    // stdout here would corrupt the first command someone runs through it.
    manifest = await ensureBinary({ log: say, warn: say });
  } catch (e) {
    bail([`could not install the crust binary: ${e.message}`, ...installHint()]);
  }
}

// Async spawn with inherited stdio rather than exec or spawnSync: crust is interactive, so it
// needs the real tty — and the shim must be a transparent SIGNAL conduit. spawnSync was not:
// a single-pid SIGTERM (Playwright stopping a webServer, systemd, a bare `kill`) hit only this
// node process, libuv put the binary down without ceremony, and a crust `procs` supervisor
// died WITHOUT running its group-kill teardown — orphaning every dev server it held. Forward
// the termination signals and let the binary do its own graceful shutdown.
const child = spawn(manifest.bin, process.argv.slice(2), { stdio: "inherit" });
child.on("error", (e) => bail([`failed to launch ${manifest.bin}: ${e.message}`]));
for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) {
  process.on(sig, () => {
    try {
      child.kill(sig);
    } catch {
      /* already gone */
    }
  });
}
child.on("exit", (code, signal) => {
  // A plain exit-code passthrough loses signals, which makes `crust` dying to SIGINT look
  // different from the binary dying to SIGINT. Re-raise instead.
  if (signal) {
    process.kill(process.pid, signal);
    return;
  }
  process.exit(code ?? 0);
});
